# ============================================
# Mini E-Commerce Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit the .env file to version control

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mini-ecommerce

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Web Push VAPID Keys (generate with: npm run generate:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Service Ports
API_GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
PRODUCT_SERVICE_PORT=5002
ORDER_SERVICE_PORT=5003
PAYMENT_SERVICE_PORT=5004
NOTIFICATION_SERVICE_PORT=5005

# Frontend
VITE_API_URL=http://localhost:5000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_VAPID_PUBLIC_KEY=

# Admin Seed Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# Node Environment
NODE_ENV=development
